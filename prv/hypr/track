# Variety
# trash wallpaper
ALT, t, =>, variety -t
# next wallpaper
-> ALT, n, =>, variety -n
-> ALT, right, =>, variety -n
# previous wallpaper
-> ALT, p, =>, variety -p
-> ALT, left, =>, variety -p
# favorite wallpaper
-> ALT, f, =>, variety -f
# pause wallpaper
-> ALT, up, =>, variety --pause
# resume wallpaper
-> ALT, down, =>, variety --resume

